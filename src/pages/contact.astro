---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
import GoogleMap from '../components/GoogleMap.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  "name": "Cliff Barbershop",
  "image": "https://cliffbarbershop.com/images/cliff-barbershop-og.svg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Muscat",
    "addressRegion": "Muscat Governorate",
    "addressCountry": "OM"
  },
  "telephone": "+96800000000",
  "email": "info@cliffbarbershop.com",
  "openingHours": ["Mo-Sa 09:00-21:00"],
  "priceRange": "$$",
  "url": "https://cliffbarbershop.com/contact",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "23.5893697",
    "longitude": "58.4425891"
  }
};
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Contact Cliff Barbershop Muscat | Book Your Appointment"
    description="Contact Cliff Barbershop in Muscat, Oman. Book your appointment for expert haircuts, shaves, and grooming services. Visit us today!"
    schema={schema}
  />

  <!-- Hero Section -->
  <section class="bg-dark-900 py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">
          Contact Us
        </h1>
        <p class="text-lg md:text-xl text-gray-300">
          Get in touch with Cliff Barbershop in Muscat. Book your appointment or ask us any questions.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="section bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h2 class="section-title mb-8">Get in Touch</h2>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-semibold text-dark-900 mb-1">Address</h3>
                <p class="text-gray-600">Muscat, Oman</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-semibold text-dark-900 mb-1">Phone</h3>
                <a href="tel:+96800000000" class="text-gray-600 hover:text-primary-600">+968 0000 0000</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-semibold text-dark-900 mb-1">Email</h3>
                <a href="mailto:info@cliffbarbershop.com" class="text-gray-600 hover:text-primary-600">info@cliffbarbershop.com</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-semibold text-dark-900 mb-1">Opening Hours</h3>
                <p class="text-gray-600">Monday - Saturday: 9:00 AM - 9:00 PM</p>
                <p class="text-gray-500 text-sm">Sunday: Closed</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-semibold text-dark-900 mb-1">Social Media</h3>
                <a href="https://instagram.com/cliff_om" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-primary-600">
                  @cliff_om on Instagram
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div>
          <h2 class="section-title mb-8">Find Us</h2>
          <GoogleMap address="Muscat, Oman" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark-900 mb-6">
        Ready to Book?
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Contact us today to schedule your appointment. We look forward to serving you!
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+96800000000" class="btn btn-primary">
          Call Now
        </a>
        <a href="https://instagram.com/cliff_om" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          Follow Us on Instagram
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
