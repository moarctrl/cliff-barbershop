---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';

const galleryImages = [
  { src: "/images/barbershop-interior.jpg", alt: "Cliff Barbershop interior - premium men's salon in Muscat, Oman", caption: "Our Barbershop" },
  { src: "/images/barber-haircut.jpg", alt: "Professional men's haircut at Cliff Barbershop Muscat", caption: "Haircut Services" },
  { src: "/images/barber-shave.jpg", alt: "Traditional hot towel shave at Cliff Barbershop Muscat", caption: "Shave Services" },
  { src: "/images/hair-styling.jpg", alt: "Men's hair styling at Cliff Barbershop Muscat", caption: "Hair Styling" },
  { src: "/images/mens-facial.jpg", alt: "Men's facial treatment at Cliff Barbershop Muscat", caption: "Facial Treatments" },
  { src: "/images/gallery-1.jpg", alt: "Premium grooming at Cliff Barbershop Muscat", caption: "Grooming Packages" }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Cliff Barbershop Gallery",
  "description": "Photo gallery of Cliff Barbershop in Muscat, Oman. View our barbershop, services, and finished looks.",
  "publisher": {
    "@type": "Organization",
    "name": "Cliff Barbershop"
  },
  "url": "https://cliffbarbershop.com/gallery"
};
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Gallery | Cliff Barbershop Muscat"
    description="View our gallery of men's grooming services at Cliff Barbershop in Muscat, Oman. See our barbershop, haircuts, shaves, and more."
    schema={schema}
  />

  <!-- Hero Section -->
  <section class="bg-dark-900 py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">
          Gallery
        </h1>
        <p class="text-lg md:text-xl text-gray-300">
          Take a look at our barbershop and the quality of our grooming services.
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="section bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map((image) => (
          <div class="group relative overflow-hidden rounded-2xl aspect-[4/3]">
            <img
              src={image.src}
              alt={image.alt}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-dark-900/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-end">
              <p class="p-4 text-white font-medium">{image.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-dark-900 mb-6">
        Book Your Appointment
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Ready to look your best? Contact us to schedule your grooming session at Cliff Barbershop.
      </p>
      <a href="/contact" class="btn btn-primary">
        Contact Us
      </a>
    </div>
  </section>
</BaseLayout>
