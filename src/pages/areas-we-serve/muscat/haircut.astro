---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEOHead from '../../../components/SEOHead.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Haircut in Muscat",
  "description": "Get the best haircut in Muscat at Cliff Barbershop. Expert men's haircuts with modern techniques. Book your appointment today!",
  "provider": {
    "@type": "HairSalon",
    "name": "Cliff Barbershop",
    "location": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Muscat",
        "addressCountry": "OM"
      }
    }
  },
  "areaServed": {
    "@type": "City",
    "name": "Muscat"
  },
  "url": "https://cliffbarbershop.com/areas-we-serve/muscat/haircut"
};
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Haircut in Muscat | Cliff Barbershop"
    description="Get the best haircut in Muscat at Cliff Barbershop. Expert men's haircuts with modern techniques. Book your appointment today!"
    breadcrumb={[
      { name: 'Home', url: 'https://cliffbarbershop.com/' },
      { name: 'Areas We Serve', url: 'https://cliffbarbershop.com/areas-we-serve' },
      { name: 'Muscat', url: 'https://cliffbarbershop.com/areas-we-serve/muscat' },
      { name: 'Haircut', url: 'https://cliffbarbershop.com/areas-we-serve/muscat/haircut' }
    ]}
    schema={schema}
  />

  <!-- Hero Section -->
  <section class="bg-dark-900 py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">
          Haircut in Muscat
        </h1>
        <p class="text-lg md:text-xl text-gray-300">
          Looking for the best haircut in Muscat? Cliff Barbershop offers expert men's haircuts with modern techniques and classic styling.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="section bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose-content">
        <h2>Professional Haircuts in Muscat</h2>
        <p>
          Cliff Barbershop is Muscat's destination for exceptional men's haircuts. Our skilled barbers combine modern techniques with classic styling to give you a look that suits your personality and lifestyle. Whether you prefer a traditional cut or a contemporary style, we deliver precision cuts that exceed expectations.
        </p>

        <h2>Why Get a Haircut in Muscat at Cliff Barbershop?</h2>
        <ul>
          <li>Expert barbers with years of experience</li>
          <li>Modern techniques and classic styling</li>
          <li>Relaxing barbershop atmosphere</li>
          <li>Premium hair products</li>
          <li>Complimentary wash and style</li>
        </ul>

        <h2>Our Haircut Styles</h2>
        <p>
          From classic cuts to modern fades, we offer a wide range of haircut styles. Our barbers take the time to understand your preferences and recommend styles that complement your face shape and hair type.
        </p>

        <h2>Book Your Haircut in Muscat</h2>
        <p>
          Ready for a fresh look? Contact us to book your haircut appointment at Cliff Barbershop in Muscat.
        </p>
      </div>

      <div class="mt-12 flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="btn btn-primary">
          Book Appointment
        </a>
        <a href="/pricing" class="btn btn-outline">
          View Pricing
        </a>
      </div>

      <!-- Related Links -->
      <div class="mt-16 pt-12 border-t border-gray-200">
        <h3 class="text-xl font-heading font-semibold text-dark-900 mb-6">Other Services in Muscat</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href="/areas-we-serve/muscat/shave" class="p-4 border border-gray-200 rounded-xl hover:border-primary-500 transition-colors">
            <span class="font-medium text-dark-900">Shave in Muscat</span>
          </a>
          <a href="/areas-we-serve/muscat/hair-styling" class="p-4 border border-gray-200 rounded-xl hover:border-primary-500 transition-colors">
            <span class="font-medium text-dark-900">Hair Styling in Muscat</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
